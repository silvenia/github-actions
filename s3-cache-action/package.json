{
  "name": "s3-cache-action",
  "version": "1.0.0",
  "description": "GitHub Action for caching with S3-compatible storage",
  "main": "dist/restore/index.js",
  "scripts": {
    "build": "npm run bundle",
    "bundle": "ncc build src/main.ts -o dist/restore && ncc build src/save-post.ts -o dist/save",
    "test": "jest"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/glob": "^0.4.0",
    "@actions/io": "^1.1.3",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^26.0.0",
    "@vercel/ncc": "^0.38.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.6.0"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}

{
  "name": "s3-cache-action",
  "version": "1.0.0",
  "description": "GitHub Action for caching with S3-compatible storage",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/",
    "bundle": "ncc build src/main.ts -o dist"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/exec": "^1.1.1",
    "@actions/glob": "^0.4.0",
    "@actions/io": "^1.1.3",
    "semver": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/semver": "^7.5.0",
    "@vercel/ncc": "^0.38.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "moduleFileExtensions": ["ts", "js", "json"]
  }
}
